{
  "expo": {
    "name": "QuickScan PDF",
    "slug": "quickscan-pdf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "scheme": "quickscan",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "QuickScan PDF needs camera access to scan documents, receipts, and IDs into PDF files.",
        "NSPhotoLibraryUsageDescription": "QuickScan PDF needs photo library access so you can import existing photos into your PDF.",
        "NSUserTrackingUsageDescription": "Your scans stay on your device. This permission lets us personalize ads; declining still shows ads that are not personalized."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.obaid.dev.quickscanpdf"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "QuickScan PDF needs camera access to scan documents, receipts, and IDs into PDF files.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QuickScan PDF needs photo library access so you can import existing photos into your PDF."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1138568424665362~3611826927",
          "iosAppId": "ca-app-pub-1138568424665362~3611826927"
        }
      ],
      "expo-tracking-transparency"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc8f4191-b7c6-48b3-967d-c34f5958a042"
      }
    }
  }
}
