{
  "expo": {
    "name": "QuickScan PDF",
    "slug": "quickscan-pdf",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#09090B",
    "scheme": "quickscan",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C5EBD"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "QuickScan PDF needs camera access to scan documents, receipts, and IDs into PDF files.",
        "NSPhotoLibraryUsageDescription": "QuickScan PDF needs photo library access so you can import existing photos into your PDF.",
        "NSUserTrackingUsageDescription": "Your scans stay on your device. This permission lets us personalize ads; declining still shows ads that are not personalized.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.obaid.dev.quickscanpdf"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundColor": "#2C5EBD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.obaid.dev.quickscanpdf"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "QuickScan PDF needs photo library access so you can import existing photos into your PDF.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1138568424665362~3611826927",
          "iosAppId": "ca-app-pub-1138568424665362~3611826927"
        }
      ],
      "expo-tracking-transparency",
      "react-native-document-scanner-plugin",
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "vision"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc8f4191-b7c6-48b3-967d-c34f5958a042"
      }
    }
  }
}
